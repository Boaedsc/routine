            "texte": ""
          },
          "Postcommunio": {
            "fichier": "Latin/Tempora/Pent01-5.txt",
            "section": "Postcommunio",
            "texte": "Tantis, Dómine, repléti munéribus: præsta, quǽsumus; ut et salutária dona capiámus, et a tua numquam laude cessémus.\n$Per Dominum"
