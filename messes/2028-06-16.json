          "Secreta": {
            "fichier": "Latin/Tempora/Pent01-5.txt",
            "section": "Secreta",
            "texte": "Hostias nostras, quǽsumus, Dómine, tibi dicátas placátus assúme: et ad perpetuum nobis tríbue proveníre subsídium.\n$Per Dominum"
          },
          "Prefatio": {
            "fichier": "Latin/Tempora/Pent01-5.txt",
            "section": "Prefatio",
